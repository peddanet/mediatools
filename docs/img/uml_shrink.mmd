classDiagram
  direction LR
  class ShrinkDatabase {
    +name
    +path
    +log
    +migrated_backup
    +init(directory, logger, name)
    +mtime_text(path)
    -_connect()
    +exists()
    +ensure()
    -_ensure_files()
    -_migrate()
    +index()
    +status(file_path)
    +is_done(file_path)
    +record(file_path)
    +record_failure(file_path, status, reason)
    +failure(file_path)
    +failures()
    +clear_failure(file_path)
    +rows()
  }
  class DatabaseRenamer {
    +root
    +old
    +new
    +log
    +walker
    +init(root, old, new, logger)
    +plan()
    +apply(plan)
  }
  class HevcEncoder {
    +crf
    +threads
    +niceness
    +probe
    +log
    +decode
    +ffmpeg
    +process
    +aborted
    +init(crf, threads, probe, logger, ffmpeg, niceness, decode)
    +default_threads()
    +command(src, dst)
    +encode(src, dst, on_progress)
    +abort()
    -_log_tail(log_path, lines)
    +validate(src, dst)
    -_info(args)
    -_error(args)
  }
  class FileResult {
    +path
    +status
    +source
    +result
    +length
    +took
    +init(path, status, source, result, length, took)
  }
  class ReplaceJournal {
    +log
    +init(logger)
    +replace(out, path, database)
    +recover(dirpath, database_of)
    +fsync_file(path)
    +fsync_dir(path)
  }
  class ShrinkOptions {
    +keep_copies
    +extensions
    +db_name
    +order
    +min_seconds
    +retry_failed
    +init(keep_copies, extensions, db_name, order, min_seconds, retry_failed)
  }
  class ShrinkPlanner {
    +root
    +log
    +opts
    +probe
    +state
    +database_of
    +journal
    +stats
    +found
    +init(root, logger, opts, probe, state, database_of, journal, results)
    +plan(stopped)
    -_candidate(path)
    -_video_size(path)
    -_drop_short(todo)
    -_set_aside_hevc(todo)
    -_checkpoint(what, cache, number, total)
    -_codec(path)
    -_duration(path)
    -_note_leftover(dirpath)
  }
  class ProgressReport {
    +root
    +log
    +datadir
    +extensions
    +db_name
    +throughput
    +lists
    +todo_bytes
    +databases
    +orphan_rows
    +init(root, logger, datadir, extensions, db_name, throughput)
    +scan()
    +write()
    +run()
  }
  class ResultTable {
    +root
    +report
    +log
    +width
    +count
    +init(root, report, log, width)
    +add(item)
    +finish()
    -_write(lines)
    +file_width(width)
    +head(width)
    +row(cells, path, width)
    +rule(left, cross, right, width)
    -_line(cells, path, width)
    +wrap(path, width)
    +cells(number, item)
    +mb(size)
    +minutes(seconds)
  }
  class Shrinker {
    +root
    +log
    +opts
    +encoder
    +state
    +planner
    +control
    +databases
    +flags
    +display
    +stats
    +found
    +init(root, logger, opts, encoder, probe, durations, throughput, display, codecs)
    +install_signal_handlers()
    +on_signal(signum, _frame)
    +database(dirpath)
    +plan()
    +run(confirm)
    -_run(confirm)
    -_report_plan(todo, total, rate)
    -_attach_bar_filter()
    -_process(path, size)
    -_broken(path, size)
    -_record_failure(path, status, reason)
    -_keep_ffmpeg_log(out, path)
    -_record_hevc()
    -_record_one_hevc(path)
    -_encode_and_replace(path, size, out, database)
    -_result(item)
    -_show(name, fraction, size)
    -_poll_stop(force)
    -_poll_restart()
    -_mark_stopping(message)
    -_remove_leftovers()
    -_size_or_none(path)
    -_remove_quietly(path)
    -_finish()
  }
  class ShrinkState {
    +durations
    +codecs
    +throughput
    +results
    +decode
    +ffmpeg_logs
    +restart
    +space
  }
  class SpaceTally {
    +earlier_src
    +earlier_out
    +run_src
    +run_out
    +init(earlier_src, earlier_out)
    +from_throughput(throughput)
    +add(src, out)
    +overall()
    +part(src, out)
    +line()
    +summary()
  }
  class ThroughputLog {
    +path
    +bytes
    +seconds
    +ratio_src
    +ratio_out
    +files
    +init(path)
    +rate()
    +ratio()
    +add(size, seconds, out_size)
    +duration_text(seconds)
  }
  ReplaceJournal ..> ShrinkDatabase
  ShrinkOptions ..> Shrinker
  ShrinkPlanner --> ReplaceJournal
  ShrinkPlanner --> ShrinkDatabase
  ShrinkPlanner --> ShrinkOptions
  ShrinkPlanner --> ShrinkState
  ShrinkPlanner ..> Shrinker
  ProgressReport ..> ShrinkDatabase
  ProgressReport --> ThroughputLog
  ResultTable ..> FileResult
  Shrinker ..> FileResult
  Shrinker --> HevcEncoder
  Shrinker --> ReplaceJournal
  Shrinker --> ShrinkDatabase
  Shrinker --> ShrinkOptions
  Shrinker --> ShrinkPlanner
  Shrinker --> ShrinkState
  Shrinker --> SpaceTally
  Shrinker --> ThroughputLog
  ShrinkState ..> ResultTable
  ShrinkState ..> SpaceTally
  ShrinkState ..> ThroughputLog
  SpaceTally ..> ThroughputLog
