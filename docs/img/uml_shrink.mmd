classDiagram
  direction LR
  class ShrinkDatabase {
    +name
    +path
    +log
    +migrated_backup
    +init(directory, logger, name)
    +mtime_text(path)
    -_connect()
    +exists()
    +ensure()
    -_migrate()
    +index()
    +status(file_path)
    +is_done(file_path)
    +record(file_path)
    +rows()
  }
  class DatabaseRenamer {
    +root
    +old
    +new
    +log
    +walker
    +init(root, old, new, logger)
    +plan()
    +apply(plan)
  }
  class HevcEncoder {
    +crf
    +threads
    +probe
    +log
    +ffmpeg
    +process
    +aborted
    +init(crf, threads, probe, logger, ffmpeg)
    +command(src, dst)
    +encode(src, dst, on_progress)
    +abort()
    -_log_tail(log_path, lines)
    +validate(src, dst)
    -_info(args)
    -_error(args)
  }
  class ShrinkOptions {
    +keep_copies
    +extensions
    +db_name
    +order
    +min_seconds
    +init(keep_copies, extensions, db_name, order, min_seconds)
  }
  class ProgressReport {
    +root
    +log
    +datadir
    +extensions
    +db_name
    +throughput
    +lists
    +todo_bytes
    +databases
    +orphan_rows
    +init(root, logger, datadir, extensions, db_name, throughput)
    +scan()
    +write()
    +run()
  }
  class Shrinker {
    +root
    +log
    +opts
    +probe
    +encoder
    +durations
    +throughput
    +databases
    +flags
    +display
    +stats
    +failed
    +init(root, logger, opts, encoder, probe, durations, throughput, display)
    +install_signal_handlers()
    +on_signal(signum, _frame)
    +database(dirpath)
    +plan()
    -_drop_short(todo)
    -_duration(path)
    +run(confirm)
    -_attach_bar_filter()
    -_process(path, size)
    -_encode_and_replace(path, size, out, database)
    -_show(name, fraction, size)
    -_replace(out, path, database)
    -_recover(dirpath)
    -_remove_tmp(dirpath)
    -_remove_quietly(path)
    -_finish()
  }
  class ThroughputLog {
    +path
    +bytes
    +seconds
    +init(path)
    +rate()
    +add(size, seconds)
    +duration_text(seconds)
  }
  ShrinkOptions ..> Shrinker
  ProgressReport ..> ShrinkDatabase
  ProgressReport --> ThroughputLog
  Shrinker --> HevcEncoder
  Shrinker --> ShrinkDatabase
  Shrinker --> ShrinkOptions
  Shrinker --> ThroughputLog
