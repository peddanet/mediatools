classDiagram
  direction LR
  class ShrinkDatabase {
    +name
    +path
    +log
    +migrated_backup
    +init(directory, logger, name)
    +mtime_text(path)
    -_connect()
    +exists()
    +ensure()
    -_migrate()
    +index()
    +status(file_path)
    +is_done(file_path)
    +record(file_path)
    +rows()
  }
  class DatabaseRenamer {
    +root
    +old
    +new
    +log
    +walker
    +init(root, old, new, logger)
    +plan()
    +apply(plan)
  }
  class HevcEncoder {
    +crf
    +threads
    +niceness
    +probe
    +log
    +ffmpeg
    +process
    +aborted
    +init(crf, threads, probe, logger, ffmpeg, niceness)
    +default_threads()
    +command(src, dst)
    +encode(src, dst, on_progress)
    +abort()
    -_log_tail(log_path, lines)
    +validate(src, dst)
    -_info(args)
    -_error(args)
  }
  class ShrinkOptions {
    +keep_copies
    +extensions
    +db_name
    +order
    +min_seconds
    +init(keep_copies, extensions, db_name, order, min_seconds)
  }
  class ProgressReport {
    +root
    +log
    +datadir
    +extensions
    +db_name
    +throughput
    +lists
    +todo_bytes
    +databases
    +orphan_rows
    +init(root, logger, datadir, extensions, db_name, throughput)
    +scan()
    +write()
    +run()
  }
  class ShrinkState {
  }
  class Shrinker {
    +root
    +log
    +opts
    +probe
    +encoder
    +state
    +control
    +databases
    +flags
    +display
    +stats
    +found
    +init(root, logger, opts, encoder, probe, durations, throughput, display, codecs)
    +install_signal_handlers()
    +on_signal(signum, _frame)
    +database(dirpath)
    +plan()
    -_drop_short(todo)
    -_set_aside_hevc(todo)
    -_checkpoint(what, cache, number, total)
    -_codec(path)
    -_duration(path)
    +run(confirm)
    -_run(confirm)
    -_report_plan(todo, total, rate)
    -_attach_bar_filter()
    -_process(path, size)
    -_record_hevc()
    -_record_one_hevc(path)
    -_encode_and_replace(path, size, out, database)
    -_show(name, fraction, size)
    -_poll_stop(force)
    -_mark_stopping(message)
    -_replace(out, path, database)
    -_recover(dirpath)
    -_note_leftover(dirpath)
    -_remove_leftovers()
    -_size_or_none(path)
    -_fsync_file(path)
    -_fsync_dir(path)
    -_remove_quietly(path)
    -_finish()
  }
  class ThroughputLog {
    +path
    +bytes
    +seconds
    +ratio_src
    +ratio_out
    +files
    +init(path)
    +rate()
    +ratio()
    +add(size, seconds, out_size)
    +duration_text(seconds)
  }
  ShrinkOptions ..> Shrinker
  ProgressReport ..> ShrinkDatabase
  ProgressReport --> ThroughputLog
  ShrinkState ..> ThroughputLog
  Shrinker --> HevcEncoder
  Shrinker --> ShrinkDatabase
  Shrinker --> ShrinkOptions
  Shrinker --> ShrinkState
  Shrinker --> ThroughputLog
