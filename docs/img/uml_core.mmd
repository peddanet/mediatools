classDiagram
  direction LR
  class AttachView {
    +control
    +stream
    +poll
    +drawn
    +init(control, stream, poll)
    +run()
    -_backlog(log)
    -_follow(log, offset)
    +terminal_lines(text)
    -_draw()
    -_clear()
  }
  class CodecCache {
    +parse(text)
    +format(value)
  }
  class Config {
    +path
    +parser
    +init(datadir)
    +exists()
    +write_template()
    +set_value(section, key, value)
    +get(section, key)
    +path_value(section, key)
    +integer(section, key)
    +db_name()
    +abbreviations()
    +require_path(section, key, given)
    +render()
  }
  class DataDir {
    +root
    +init(root)
    +sub(name)
    +file(sub, prefix, suffix)
    +stamp()
  }
  class DurationCache {
    +path
    +entries
    +hits
    +added
    +init(path)
    +get(file_path, st)
    +put(file_path, st, duration)
    +save()
    +parse(text)
    +format(value)
  }
  class MediaTypes {
    +FLAT_DIR
    +SHRINK_TMP_DIR
    +SKIP_DIRS
    +VIDEO
    +IMAGE
    +AUDIO
    +MEDIA
    +extension(name)
    +is_media(name)
    +is_video(name)
    +parse_extensions(csv)
  }
  class MediaProbe {
    +ffprobe
    +init(ffprobe)
    +available()
    +value(path, entry, stream)
    +duration(path)
    +video_codec(path)
    +has_video(path)
  }
  class ProgressBar {
    +total_bytes
    +total_files
    +done_bytes
    +done_files
    +initial_rate
    +stream
    +started
    +enabled
    +note
    +drawn
    +status_path
    +last_status
    +init(total_bytes, total_files, initial_rate, stream)
    +rate(current_bytes)
    +remaining_seconds(current_bytes)
    +line(_name, file_fraction, file_bytes)
    +file_line(name, file_fraction, file_bytes, width)
    -_write_status(name, file_fraction, file_bytes)
    +show(name, file_fraction, file_bytes)
    +file_done(size)
    +file_skipped(size)
    +clear()
    +duration_text(seconds)
  }
  class Prompt {
    +assume_yes
    +input
    +init(assume_yes, input_func)
    +yes_no(question, default)
    +text(question, default)
  }
  class RunControl {
    +name
    +pid_file
    +stop_file
    +status_file
    +console_file
    +last_poll
    +background
    +inhibitor
    +log_path
    +init(name, data, background, inhibitor, log_path)
    +start()
    -_register()
    +begin_work()
    +detach()
    +finish()
    +stop_requested(force)
    +active_pid()
    +active_log()
    +request_stop()
    -_remove(path)
  }
  class RunLog {
    +datadir
    +path
    +logger
    +init(name, verbose, datadir)
    +close()
  }
  class SleepInhibitor {
    +why
    +log
    +proc
    +init(why, log, inhibit)
    +start()
    +stop()
    -_warn(message)
  }
  class VersionInfo {
    +package_dir
    +version
    +init(package_dir, version)
    +checkout()
    +describe()
  }
  class TreeWalker {
    +skip
    +init(extra_skip)
    +walk(root)
    +files(root)
    +media_files(root, extensions)
  }
  AttachView --> RunControl
  CodecCache ..> DurationCache
  Config --> DataDir
  RunControl --> DataDir
  RunControl --> SleepInhibitor
  RunLog --> DataDir
  RunLog --> VersionInfo
  TreeWalker --> MediaTypes
